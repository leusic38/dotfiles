#!/bin/sh
# Synchronise le courrier et signale les nouveaux messages.
#
#   mail-sync          synchronise, notifie, rafraichit la barre
#   mail-sync --quiet  synchronise sans notifier (premiere synchro, cron)
#
# Appele par mbsync.timer toutes les 3 minutes, et a la molette haut sur le
# segment courrier de la barre.
#
# Comment le neuf est detecte : on liste les fichiers de */INBOX/new avant et
# apres mbsync ; les noms apparus sont les nouveaux messages. Pas de base, pas
# d'etat a maintenir — le Maildir est deja la source de verite.
#
# En cas d'echec, l'horodatage n'est pas mis a jour, ce qui fait apparaitre
# le suffixe « ! » dans la barre au bout de 30 minutes. Deux causes possibles :
#   - mbsync echoue (reseau, etc.) : aucune notification -- un reseau coupe
#     n'est pas un evenement digne d'un popup toutes les 3 minutes, et la
#     barre suffit a le signaler.
#   - le coffre rbw est verrouille (detecte en amont, avant mbsync) : UNE
#     notification dunst, mais une seule par episode de verrouillage. Le
#     timer tourne en permanence ; sans ce garde-fou, chaque execution
#     renverrait un popup identique tant que le coffre reste verrouille --
#     jusqu'a ce qu'Emmanuel apprenne a les ignorer, ce qui viderait la
#     notification de son interet. Le fichier marqueur pose pres du controle
#     rbw ci-dessous retient qu'on a deja prevenu pour cet episode ; il est
#     efface des qu'une synchro reussit de nouveau, pour que le prochain
#     verrouillage redonne bien lieu a une notification.
# Le detail des echecs mbsync est dans journald : journalctl --user -t
# mail-sync (et non "-u mbsync.service" : ce script est aussi lance hors de
# cette unite, depuis la molette de la barre, donc son flux d'erreur ne
# porte que son identifiant syslog, pas les metadonnees de l'unite que "-u"
# filtre).
#
# Attention en debug : un "mbsync -D" lance a la main fait passer tout le
# dialogue IMAP, LOGIN compris, dans ce meme flux -- donc dans journald.
#
# Pourquoi mbsync est borne par "timeout" : en exploitation, le coffre rbw
# s'est verrouille pendant qu'un mbsync tournait deja. Sa directive PassCmd a
# relance "rbw get", qui a lance pinentry en attente d'une saisie -- saisie
# qui ne viendrait jamais dans un service systemd sans terminal. mbsync n'est
# jamais mort, le verrou flock ne s'est jamais libere, et comme sortir a 0 sur
# contention est le comportement correct pour un chevauchement bref avec la
# molette de la barre, chaque execution suivante du timer repartait en
# silence avec un code de succes : mbsync.service se disait "reussi" a chaque
# echeance, pendant cinq jours, sans plus rien synchroniser. Un mbsync qui ne
# rend pas la main dans le delai imparti est en panne, quelle qu'en soit la
# cause ; le borner rend "bloque pour toujours" impossible et laisse le
# chemin d'echec ci-dessus (code non nul, pas de notification, horodatage
# fige) faire son travail au lieu de rester invisible.
#
# Surchargeables pour les tests :
#   MAIL_ROOT       racine du Maildir
#   MBSYNC_CMD      commande tenant lieu de mbsync
#   NOTIFY_CMD      commande tenant lieu de notify-send
#   RBW_CMD         commande tenant lieu de rbw (verification du verrouillage)
#   MBSYNC_TIMEOUT  secondes avant d'abandonner un mbsync qui ne rend pas la main

set -u

maildir="${MAIL_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/mail}"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/statusbar"
stamp="$cache/mail_sync"
lock="$cache/mail_sync.lock"
# Marqueur d'episode de verrouillage rbw : sa seule presence dit "on a deja
# notifie pour ce verrouillage-la". Cree a la premiere detection, efface des
# qu'une synchro reussit -- voir le commentaire d'en-tete pour le pourquoi.
locked_marker="$cache/mail_sync.rbw_locked"
# Surchargeables pour les tests, comme firefox-profile-handler.sh et mdview le
# font deja : sans ca, verifier la detection du neuf imposerait de s'envoyer de
# vrais messages et d'attendre, ou de couper le reseau.
MBSYNC_CMD="${MBSYNC_CMD:-mbsync}"
NOTIFY_CMD="${NOTIFY_CMD:-notify-send}"
RBW_CMD="${RBW_CMD:-rbw}"
# Inferieur aux 3 minutes du timer, pour qu'une execution bloquee ne puisse
# jamais chevaucher la suivante (voir l'incident rbw/pinentry ci-dessus).
MBSYNC_TIMEOUT="${MBSYNC_TIMEOUT:-120}"
quiet=0

case ${1-} in
    --quiet)   quiet=1 ;;
    -h|--help) sed -n '2,35p' "$0" | sed 's/^# \?//'; exit 0 ;;
    "")        ;;
    *)         echo "option inconnue : $1 (voir --help)" >&2; exit 2 ;;
esac

mkdir -p "$cache"

# Le timer et la molette de la barre peuvent tomber en meme temps : le second
# arrivant repart sans rien faire plutot que de lancer un mbsync concurrent.
exec 9>"$lock"
flock -n 9 || exit 0

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT

# Coffre verrouille : PassCmd echouerait dans mbsync avec deux lignes
# obscures par tentative (voir l'incident pinentry ci-dessus). On le
# detecte ici pour sortir tout de suite, avec un message qui dit quoi faire.
# Si rbw n'est pas installe (pile mail utilisable sans Bitwarden), on passe
# outre et on laisse mbsync decider.
if command -v "$RBW_CMD" >/dev/null 2>&1 && ! "$RBW_CMD" unlocked >/dev/null 2>&1; then
    echo "mail-sync: coffre rbw verrouille -- lancer : rbw unlock" >&2
    # Une seule notification par episode : sans le marqueur, le timer (toutes
    # les 3 minutes) en renverrait une identique a chaque execution tant que
    # le coffre reste verrouille -- noyant dunst au point qu'Emmanuel
    # apprendrait a les ignorer, ce qui annulerait l'interet de la
    # notification. On ne notifie donc qu'a la transition (premier echec de
    # l'episode) ; le marqueur est efface plus bas des qu'une synchro reussit,
    # pour que le prochain verrouillage redonne bien lieu a une notification.
    if [ ! -e "$locked_marker" ]; then
        : > "$locked_marker"
        $NOTIFY_CMD -u critical "✉ Courrier" "Coffre rbw verrouille -- lancer : rbw unlock"
    fi
    exit 1
fi

inventaire() {
    find "$maildir"/*/INBOX/new -type f 2>/dev/null | sort
}

inventaire > "$tmp/avant"

if ! timeout "$MBSYNC_TIMEOUT" $MBSYNC_CMD -a >"$tmp/log" 2>&1; then
    sed 's/^/mbsync: /' "$tmp/log" >&2
    exit 1
fi

inventaire > "$tmp/apres"
comm -13 "$tmp/avant" "$tmp/apres" > "$tmp/nouveaux"

# La synchro a reussi : on remet a zero l'episode de verrouillage rbw, sinon
# un futur verrouillage ne redonnerait plus jamais de notification.
rm -f "$locked_marker"

date +%s > "$stamp"

# Rafraichir la barre sans attendre le prochain tour de sa boucle.
compteur="$HOME/.local/bin/statusbar/mailmod/mail"
[ -x "$compteur" ] && duskc --ignore-reply run_command setstatus 11 "$("$compteur")" 2>/dev/null

[ "$quiet" -eq 1 ] && exit 0

n=$(wc -l < "$tmp/nouveaux")
[ "$n" -eq 0 ] && exit 0

# Les en-tetes encodes (=?UTF-8?B?...?=) sont illisibles bruts dans dunst.
decoder() {
    perl -MEncode -CS -pe '$_ = Encode::decode("MIME-Header", $_)' 2>/dev/null \
        || cat
}

entete() {
    # $1 = fichier, $2 = nom de l'en-tete. S'arrete au corps du message et
    # recolle les lignes de continuation (RFC 5322 « folding »).
    # La premiere regle retire un \r de fin de ligne eventuel : sous CRLF, la
    # ligne vide separant en-tetes et corps vaut "\r" et non "", donc /^$/ ne
    # la reconnaitrait pas sans cette normalisation — le balayage deborderait
    # alors dans le corps du message. Meme regle, elle evite au passage un \r
    # residuel dans les valeurs d'en-tete recopiees par print.
    awk -v h="^$2:" '
        { sub(/\r$/, "") }
        /^$/ { exit }
        tolower($0) ~ tolower(h) { found = 1; sub(/^[^:]*:[ \t]*/, ""); print; next }
        found && /^[ \t]/ { sub(/^[ \t]+/, " "); print; next }
        found { exit }
    ' "$1" | tr -d '\n' | decoder
}

# Au-dela de 3, un popup par message noierait dunst.
if [ "$n" -gt 3 ]; then
    $NOTIFY_CMD "✉ Courrier" "$n nouveaux messages."
else
    while read -r f; do
        [ -f "$f" ] || continue
        $NOTIFY_CMD "✉ $(entete "$f" From)" "$(entete "$f" Subject)"
    done < "$tmp/nouveaux"
fi
