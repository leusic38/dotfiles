#!/bin/sh

# Micro : icône Nerd Font, barrée quand il est coupé.
if [ "$(pamixer --default-source --get-mute)" = true ]; then
	mic="󰍭"
else
	mic="󰍬"
fi

[ $(pamixer --get-mute) = true ] && echo "$mic 🔇" && exit

vol="$(pamixer --get-volume)"

if [ "$vol" -gt "70" ]; then
	icon="🔊"
elif [ "$vol" -lt "30" ]; then
	icon="🔈"
else
	icon="🔉"
fi

echo "$mic $icon $vol%"
