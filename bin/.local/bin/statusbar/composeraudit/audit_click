#!/bin/sh
mod="$HOME/.local/bin/statusbar/composeraudit"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/statusbar/composer_audit.json"
projects_root="${COMPOSER_AUDIT_ROOT:-$HOME/Projects}"

case $BLOCK_BUTTON in
1) notify-send "🔒 Composer audit" "🔒: vulnérabilités dans tes projets ~/Projects
- clic gauche : aide
- clic milieu : terminal dans le projet le plus impacté (composer audit)
- clic droit : détail par projet et package
- molette haut : relancer l'audit
- molette bas : ouvrir tous les liens d'advisories" ;;
2)
	top=$(jq -r '[.projects | to_entries[] | select(.value.count > 0)]
		| max_by(.value.count) | .key // ""' "$cache" 2>/dev/null)
	if [ -z "$top" ]; then
		notify-send -t 2000 "🔒 Composer audit" "Aucun projet vulnérable."
	elif [ ! -d "$projects_root/$top" ]; then
		notify-send "🔒 Composer audit" "Le projet « $top » n'existe plus.
Cache périmé : relance l'audit (molette haut)."
	else
		setsid -f "$TERMINAL" -e sh -c 'cd "$1" && composer audit; exec $SHELL' \
			sh "$projects_root/$top"
	fi
	;;
3)
	if [ ! -f "$cache" ]; then
		notify-send "🔒 Composer audit" "Aucun cache. Lance audit_refresh d'abord."
		exit 0
	fi
	body=$(jq -r '
		.projects
		| to_entries[]
		| select(.value.count > 0)
		| "📁 \(.key) — \(.value.count) advisor\(if .value.count > 1 then "ies" else "y" end)\n" +
		  ([.value.advisories | to_entries[] |
		    "  • \(.key) (\(.value | length))"] | join("\n"))
	' "$cache" 2>/dev/null)
	[ -z "$body" ] && body="✅ Aucune vulnérabilité connue."
	ts=$(jq -r '.timestamp // 0' "$cache" 2>/dev/null)
	[ "$ts" -gt 0 ] && when=$(date -d "@$ts" "+%d/%m %H:%M") || when="?"
	notify-send "🔒 Composer audit (maj: $when)" "$body"
	;;
4)
	notify-send -t 2000 "🔒 Composer audit" "Audit en cours…"
	# statusbar_launch ne repousse le bloc que toutes les 600s : on le fait
	# nous-mêmes, sinon un refresh manuel reste invisible jusqu'à 10 min.
	{
		"$mod/audit_refresh"
		command -v duskc >/dev/null &&
			duskc --ignore-reply run_command setstatus 10 "$("$mod/audit")"
		notify-send -t 2000 "🔒 Composer audit" "Audit terminé."
	} &
	;;
5)
	urls=$(jq -r '.projects[].advisories[]?[]?.link // empty' "$cache" 2>/dev/null | sort -u)
	if [ -z "$urls" ]; then
		notify-send -t 2000 "🔒 Composer audit" "Aucun lien d'advisory."
		exit 0
	fi
	echo "$urls" | while IFS= read -r u; do xdg-open "$u" >/dev/null 2>&1 & done
	;;
esac
